{
  "rewrites": [
    { "source": "/download", "destination": "/" },
    { "source": "/updates", "destination": "/" },
    { "source": "/privacy", "destination": "/" },
    { "source": "/cookies", "destination": "/" },
    { "source": "/terms", "destination": "/" }
  ],
  "headers": [
    { "source": "/update.json", "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0" }] },
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
